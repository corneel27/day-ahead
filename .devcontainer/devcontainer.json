{
  "name": "Day Ahead development",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "remoteUser": "root",
  "forwardPorts": [
    5000,
    5173
  ],
  "portsAttributes": {
    "5000": {
      "label": "Day Ahead web preview",
      "onAutoForward": "notify"
    },
    "5173": {
      "label": "Vite assets",
      "onAutoForward": "silent"
    }
  },
  "postCreateCommand": "git config --global --add safe.directory \"$PWD\" && sh script/setup",
  "waitFor": "postCreateCommand",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "ms-python.debugpy",
        "charliermarsh.ruff"
      ],
      "settings": {
        "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python"
      }
    }
  }
}
